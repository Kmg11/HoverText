<Window x:Class="HoverTextWin.OverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="HoverTextOverlay"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        Topmost="True"
        ResizeMode="NoResize"
        SizeToContent="WidthAndHeight"
        WindowStartupLocation="Manual">
    <Border Background="#EE1E1E1E"
            CornerRadius="10"
            Padding="16,12"
            BorderBrush="#55FFFFFF"
            BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect BlurRadius="18" ShadowDepth="0" Opacity="0.5" Color="Black" />
        </Border.Effect>
        <TextBlock x:Name="HoverTextBlock"
                   Foreground="White"
                   FontSize="32"
                   FontFamily="Segoe UI"
                   TextWrapping="Wrap" />
    </Border>
</Window>
