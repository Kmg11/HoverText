<Window x:Class="HoverText.OnboardingWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Welcome to Hover Text"
        Width="500"
        SizeToContent="Height"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        Topmost="True"
        ShowInTaskbar="False"
        Background="#FF1E1E1E"
        FontFamily="Segoe UI">
    <StackPanel Margin="28">
        <TextBlock Text="Welcome to Hover Text"
                   FontSize="24" FontWeight="Bold" Foreground="White" />
        <TextBlock Text="Read any text on screen, magnified right at your cursor — using the real text, not a pixel zoom."
                   TextWrapping="Wrap" Margin="0,8,0,0" Foreground="#FFBDBDBD" />

        <TextBlock Text="HOW IT WORKS" FontSize="12" FontWeight="SemiBold"
                   Foreground="#FF888888" Margin="0,22,0,12" />

        <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
            <Border Width="24" Height="24" CornerRadius="12" Background="#FF0078D4">
                <TextBlock Text="1" HorizontalAlignment="Center" VerticalAlignment="Center"
                           Foreground="White" FontWeight="Bold" FontSize="13" />
            </Border>
            <TextBlock Margin="12,1,0,0" TextWrapping="Wrap" Foreground="#FFE8E8E8">
                <Run Text="Hold the " /><Run x:Name="TriggerKeyRun" Text="Left Ctrl" FontWeight="Bold" /><Run Text=" key and keep holding it." />
            </TextBlock>
        </StackPanel>

        <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
            <Border Width="24" Height="24" CornerRadius="12" Background="#FF0078D4">
                <TextBlock Text="2" HorizontalAlignment="Center" VerticalAlignment="Center"
                           Foreground="White" FontWeight="Bold" FontSize="13" />
            </Border>
            <TextBlock Margin="12,1,0,0" TextWrapping="Wrap" Foreground="#FFE8E8E8">
                <Run Text="Point at any text on the screen — a label, a paragraph, a link." />
            </TextBlock>
        </StackPanel>

        <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
            <Border Width="24" Height="24" CornerRadius="12" Background="#FF0078D4">
                <TextBlock Text="3" HorizontalAlignment="Center" VerticalAlignment="Center"
                           Foreground="White" FontWeight="Bold" FontSize="13" />
            </Border>
            <TextBlock Margin="12,1,0,0" TextWrapping="Wrap" Foreground="#FFE8E8E8">
                <Run Text="A large popup appears near the cursor showing the real text underneath it." />
            </TextBlock>
        </StackPanel>

        <StackPanel Orientation="Horizontal">
            <Border Width="24" Height="24" CornerRadius="12" Background="#FF0078D4">
                <TextBlock Text="4" HorizontalAlignment="Center" VerticalAlignment="Center"
                           Foreground="White" FontWeight="Bold" FontSize="13" />
            </Border>
            <TextBlock Margin="12,1,0,0" TextWrapping="Wrap" Foreground="#FFE8E8E8">
                <Run Text="Release the key to hide the popup. Move over other text and it updates." />
            </TextBlock>
        </StackPanel>

        <Border Background="#FF2B2B2B" CornerRadius="6" Padding="12,10" Margin="0,20,0,0">
            <TextBlock TextWrapping="Wrap" Foreground="#FFBDBDBD">
                <Run Text="Tip: right-click the tray icon for " />
                <Run Text="Options..." FontWeight="SemiBold" Foreground="White" />
                <Run Text=" to change the trigger key, size, and theme — or " />
                <Run Text="Exit" FontWeight="SemiBold" Foreground="White" />
                <Run Text=" to quit." />
            </TextBlock>
        </Border>

        <Button Content="Got it" Width="110" Height="34" HorizontalAlignment="Right"
                Margin="0,22,0,0" Click="GotIt_Click" />
    </StackPanel>
</Window>
